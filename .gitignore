node_modules/
dist/
coverage/
*.tgz
*.tsbuildinfo
.astro/
.wrangler/
.DS_Store
*.log
.env
.env.*
!.env.example
.fwtmp
# Generated by @nifrajs/web/vite's dev server (the codegen'd client entry written at the app root).
.nifra-vite-entry.tsx
.nifra-bun/
# Generated by `nifra dev`'s Bun pipeline: the bunfig + boundary plugin it re-execs with.
.nifra/
bench/size/.tmp
# In-workspace temp app dirs created by build integration tests (cleaned in afterEach; this guards a
# crashed run from leaving an uncommitted dir). They must live in-tree so @nifrajs/* resolves.
packages/web/test/.tmp-*

# Internal working docs (planning, design, audit) - kept on disk for local reference, never committed.
# (README.md stays tracked.)
/AUDIT*.md
/REPOSITORY_AUDIT.md
/*FEEDBACK*.md
/*_report.md

# Benchmark RESULTS - generated locally, never committed (numbers move with machine load; see
# bench/README.md). The benchmark CODE under bench/ stays tracked.
/BENCHMARKS.md
/SSR-BENCHMARKS.md
/BENCHMARKS-REALWORLD.md
/BENCHMARKS-PERFORMANCE.json
/bench-ci/
bench/.tmp-performance-*/
packages/schema/test/.tmp-precompiled-*/
packages/node/test-node/.tmp-precompiled-*/
/PLAN.md
/*-PLAN.md
/*-PARITY.md
/PHASE*.md
/FRONTEND.md
/FRONTEND-F*.md
/ADAPTERS.md
/RUNTIMES.md
/SITE.md
/TYPED-ENV.md
/QUERY-CACHE.md
/*-REVIEW.md
/WEBSOCKETS*.md
bench/**/*.md
!bench/README.md
!bench/techempower/README.md
!bench/http/worst-case/README.md
!bench/ssr/README.md
!bench/memory/README.md
!bench/profiling/README.md
!bench/profiling/FINDINGS-2026-10-21.md
!bench/profiling/OPTIMIZATIONS-2026-10-21.md
!bench/profiling/ROUND2-2026-10-21.md
!bench/profiling/PROTO-GUARD-2026-10-21.md
!bench/profiling/FASTLANES-2026-10-22.md
/plans

# Local editor/agent tooling - machine-specific (absolute paths, local settings); never committed.
.claude/launch.json
.claude/settings.local.json
.code-review-graph/

# check:docs snippet sandbox (transient) - lives under site/ so workspace @nifrajs/* symlinks resolve
site/.tmp-doc-check
.codex/
/packages/core/test/.tmp-nifra-many-routes

# Local scratch + private test files
/.private/
/.serena/

# Local Vite-prod build output dirs from manual --vite verification
dv-*/
/examples/launch-video
/launch-assets
/scratch

# Local planning and editor state - never public. `/.planning` in particular carries private
# roadmap notes, so the leak guard must never see it as committable content.
/.planning
/.vscode/

# Isolated tree of PUBLISHED @nifrajs packages for benchmarking a release (generated)
/bench/.published
/data/browser
/output
/.security
/.pi
/.playwright-cli
/vite-split-*.png
/docs/
/.nifra-components-fixtures/

# Output of scripts/mutate.ts (kill matrix, survivors, summary).
/.mutation/
packages/deno/test/.tmp-*/
packages/cli/test/.db-tool-*/
/bench-logs
