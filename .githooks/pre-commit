#!/usr/bin/env bash
#
# Pre-commit gates, in order:
#   1. Source-derived docs (api-reference.md + LLM.md cards) regenerate + re-stage when package
#      source is staged - so CI's check:api / check:cards can never fail on a stale artifact.
#   2. Biome lint/format on every staged lintable file, auto-fixing what it can - so a formatting
#      slip can never land on main and fail CI's lint step.
#   3. llms-corpus tripwire: a staged docs page without the regenerated corpus is refused - the
#      regeneration is NOT run here (types.json needs a full build; a stale dist would silently
#      gut it), the hook just says exactly what to run.
#
# Both generators in (1) extract every public export from each `src/index.ts` with the TypeScript
# compiler API - they read SOURCE, not `dist`, so they need no build and run in a few seconds. They run
# against a throwaway checkout of the INDEX, never the working tree: see gate 1.
#
# Activated via `core.hooksPath=.githooks` (set by the root `prepare` script on install; see package.json).
set -euo pipefail

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: 'bun' not found - install bun to run the commit gates." >&2
  exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# ---- 1. Source-derived docs --------------------------------------------------------------------
# Any staged add/copy/modify/rename under a package's src, or to a doc generator, can change the
# exported API surface the docs are built from.
#
# The generators run against a THROWAWAY CHECKOUT OF THE INDEX, not the working tree. Reading the
# working tree would document code that is not in this commit: an unstaged export elsewhere in the repo
# (a `git add -p` split, a partially staged file, a second checkout/agent editing another package) would
# be extracted, staged by the `git add` below, and committed - and CI's check:api, which rebuilds from
# the COMMITTED source, would then fail on it. This is the same rule gate 2 applies to partially staged
# files: never sweep unstaged work into a commit.
#
# `git checkout-index` materializes exactly what is staged. The generators are then executed FROM that
# snapshot, so their `ROOT` (`import.meta.dir/..`) and every relative import they make - including
# gen-llm-cards' import of the CLI command catalog - resolve inside it. `node_modules` is symlinked in
# for third-party types; workspace `@nifrajs/*` imports resolve through the snapshot's own tsconfig
# `paths` (which point at `./packages/*/src`), so cross-package types come from the index too.
#
# EVERY `node_modules` is linked in, root AND per-package. A bun workspace installs a dependency that
# only one package declares into that package's own `node_modules`, so a snapshot carrying only the
# root one cannot resolve typebox, preact, react or solid-js - and the extractor degrades those
# signatures to `any` instead of failing, silently rewriting the committed docs.
if grep -qE '^(packages/[^/]+/src/.*\.ts|scripts/gen-(api-reference|llm-cards)\.ts)$' <<< "$STAGED"; then
  echo "pre-commit: package source staged - refreshing api-reference.md + LLM.md cards from the index…"
  REPO_ROOT=$(git rev-parse --show-toplevel)
  SNAPSHOT=$(mktemp -d "${TMPDIR:-/tmp}/nifra-precommit-index-XXXXXX")
  trap 'rm -rf "$SNAPSHOT"' EXIT
  git checkout-index -a -f --prefix="$SNAPSHOT/"
  ln -s "$REPO_ROOT/node_modules" "$SNAPSHOT/node_modules"
  for PKG_MODULES in "$REPO_ROOT"/packages/*/node_modules; do
    [ -d "$PKG_MODULES" ] || continue
    PKG_DIR="$SNAPSHOT/packages/$(basename "$(dirname "$PKG_MODULES")")"
    [ -d "$PKG_DIR" ] && ln -s "$PKG_MODULES" "$PKG_DIR/node_modules"
  done

  # Both generators self-check their output (a resolution failure empties the export lists and they
  # exit non-zero), so a snapshot that cannot resolve fails the commit loudly instead of writing stubs.
  bun "$SNAPSHOT/scripts/gen-api-reference.ts" >/dev/null
  bun "$SNAPSHOT/scripts/gen-llm-cards.ts" >/dev/null

  # Copy the index-derived artifacts back over the working tree. These files are generated, never
  # hand-edited ("Do not edit by hand - run `bun run gen:cards`"), so there is no local edit to lose.
  cp "$SNAPSHOT/api-reference.md" "$REPO_ROOT/api-reference.md"
  for CARD in "$SNAPSHOT"/packages/*/LLM.md; do
    cp "$CARD" "$REPO_ROOT/packages/$(basename "$(dirname "$CARD")")/LLM.md"
  done

  # Stage only the generated artifacts (no-op when nothing changed). Never touches other files.
  git add -- api-reference.md packages/*/LLM.md

  if ! git diff --cached --quiet -- api-reference.md packages/*/LLM.md; then
    echo "pre-commit: docs regenerated and staged into this commit."
  fi
  # A changed api-reference means the public surface moved - types.json is built from the same
  # exports (including doc/description text), so it is almost certainly stale too. It cannot be
  # regenerated here: it needs a fresh `bun run build` first (a stale dist silently guts it).
  if ! git diff --cached --quiet -- api-reference.md; then
    API_SURFACE_CHANGED=1
  fi
fi

# ---- 1b. types-corpus tripwire -----------------------------------------------------------------
# CI's check:llms rebuilds from scratch and diffs types.json; catching it here saves the red run.
if [ "${API_SURFACE_CHANGED:-0}" = 1 ] && [ "${NIFRA_LLMS_OK:-0}" != 1 ] \
  && ! git diff --cached --name-only | grep -q '^packages/cli/docs/types.json$'; then
  echo "pre-commit: the public API surface changed (api-reference.md moved) but packages/cli/docs/types.json is not staged." >&2
  echo "pre-commit: run 'bun run build && bun run gen:llms', stage the regenerated files, and commit again." >&2
  echo "pre-commit: if that provably changes nothing, re-run the commit with NIFRA_LLMS_OK=1." >&2
  exit 1
fi

# ---- 2. Lint/format gate -----------------------------------------------------------------------
# Fully-staged files are auto-fixed and re-staged; a PARTIALLY staged file (staged + further
# unstaged edits) is only checked, never auto-added - `git add` after a fix would silently sweep
# the unstaged hunks into this commit.
LINTABLE=$(grep -E '\.(ts|tsx|js|jsx|json|jsonc)$' <<< "$STAGED" || true)
if [ -n "$LINTABLE" ]; then
  FIXABLE=()
  CHECK_ONLY=()
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if git diff --quiet -- "$f"; then FIXABLE+=("$f"); else CHECK_ONLY+=("$f"); fi
  done <<< "$LINTABLE"
  if [ ${#FIXABLE[@]} -gt 0 ]; then
    bunx biome check --write --no-errors-on-unmatched "${FIXABLE[@]}" >/dev/null 2>&1 || true
    git add -- "${FIXABLE[@]}"
  fi
  ALL_STAGED=()
  [ ${#FIXABLE[@]} -gt 0 ] && ALL_STAGED+=("${FIXABLE[@]}")
  [ ${#CHECK_ONLY[@]} -gt 0 ] && ALL_STAGED+=("${CHECK_ONLY[@]}")
  if [ ${#ALL_STAGED[@]} -gt 0 ] && ! bunx biome check --no-errors-on-unmatched "${ALL_STAGED[@]}" >/dev/null 2>&1; then
    echo "pre-commit: biome found problems it could not auto-fix (or a partially-staged file needs fixing):" >&2
    bunx biome check --no-errors-on-unmatched "${ALL_STAGED[@]}" 2>&1 | tail -20 >&2
    echo "pre-commit: fix (bunx biome check --write <file>), re-stage, and commit again." >&2
    exit 1
  fi
fi

# ---- 3. llms-corpus tripwire -------------------------------------------------------------------
# llms-full.txt inlines two prose sources gen-llms.ts reads verbatim: every `site/routes/docs/*.tsx`
# page AND every package `README.md` (see the "Package reference (READMEs)" section it emits). A
# staged edit to either leaves the corpus stale, and CI's check:llms rebuilds and diffs it - so both
# inputs must trip this gate, not just docs pages. (A README prose edit is what slipped a stale
# corpus onto main before this arm existed.) The corpus is NOT regenerated here: gen-llms.ts needs a
# fresh declaration build first, and a stale dist would silently gut types.json - so the hook refuses
# and says exactly what to run, the same contract as gate 1b.
#
# A docs edit that touches only a fenced code sample regenerates to a byte-identical llms-full.txt, so
# the file can never be staged and the tripwire would be unsatisfiable; `NIFRA_LLMS_OK=1` is the same
# escape hatch gate 1b uses: set it only after `bun run build && bun run gen:llms` left the corpora
# clean (`bun run check:llms` confirms).
if grep -qE '^(site/routes/docs/.*\.(tsx|mdx)|packages/[^/]+/README\.md)$' <<< "$STAGED" \
  && [ "${NIFRA_LLMS_OK:-0}" != 1 ]; then
  if ! git diff --cached --name-only | grep -q '^llms-full.txt$'; then
    echo "pre-commit: a docs page or package README is staged but llms-full.txt is not - the llms corpora are stale." >&2
    echo "pre-commit: run 'bun run build && bun run gen:llms', stage the regenerated files, and commit again." >&2
    echo "pre-commit: if that provably changes nothing, re-run the commit with NIFRA_LLMS_OK=1." >&2
    exit 1
  fi
fi

# ---- Local extension point ---------------------------------------------------------------------
# An untracked, machine-local hook may add extra gates (it lives in .git/hooks/, never committed).
if [ -x .git/hooks/pre-commit-local ]; then
  .git/hooks/pre-commit-local
fi
