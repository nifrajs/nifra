+/** Whether the request target's path is `prefix` or lies under it, without cutting the path out. */
+export function pathUnder(url: string, prefix: string): boolean {
+  const schemeEnd = url.indexOf("://")
+  const start = schemeEnd === -1 ? url.indexOf("/") : url.indexOf("/", schemeEnd + 3)
+  if (start === -1) return prefix === "/"
+  if (!url.startsWith(prefix, start)) return false
+  const next = start + prefix.length
+  if (next === url.length) return true
+  const c = url.charCodeAt(next)
+  return c === 47 /* / */ || c === 63 /* ? */ || c === 35 /* # */
+}
