{
  "name": "@nifrajs/a2a",
  "version": "3.3.0",
  "description": "Mount a nifra agent as an Agent2Agent (A2A) protocol server - the agent card on GET, the A2A 1.0 JSON-RPC binding on POST with SendMessage, streaming SendStreamingMessage over SSE, and GetTask projected from the runner's turn state. A protocol bridge over @nifrajs/agent; the model, state store, and approval transport stay injected per request.",
  "keywords": [
    "bun",
    "typescript",
    "nifra",
    "a2a",
    "agent2agent",
    "agents",
    "json-rpc",
    "sse",
    "interop"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dts.ts dist"
  },
  "peerDependencies": {
    "@nifrajs/agent": "workspace:^",
    "@nifrajs/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@nifrajs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nifrajs/agent": "workspace:*",
    "@nifrajs/core": "workspace:*",
    "@nifrajs/schema": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nifrajs/nifra.git",
    "directory": "packages/a2a"
  },
  "bugs": {
    "url": "https://github.com/nifrajs/nifra/issues"
  },
  "homepage": "https://github.com/nifrajs/nifra#readme"
}
