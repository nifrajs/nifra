{
  "name": "@nifrajs/node-engine",
  "version": "5.17.0",
  "description": "Serve a nifra app from Node on Nifra's native Rust engine (HTTP/1.1, HTTP/2, TLS, WebSocket, and CONNECT tunnels over libuv/epoll/io_uring).",
  "keywords": [
    "nifra",
    "node",
    "http",
    "http2",
    "websocket",
    "tls",
    "native",
    "rust",
    "adapter",
    "server"
  ],
  "type": "module",
  "nifra": {
    "environment": "backend"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cluster": {
      "types": "./dist/cluster.d.ts",
      "default": "./dist/cluster.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dts.ts dist"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@nifrajs/node": "^5.14.0"
  },
  "optionalDependencies": {
    "@nifrajs/node-engine-darwin-arm64": "workspace:*",
    "@nifrajs/node-engine-darwin-x64": "workspace:*",
    "@nifrajs/node-engine-linux-arm64-gnu": "workspace:*",
    "@nifrajs/node-engine-linux-arm64-musl": "workspace:*",
    "@nifrajs/node-engine-linux-x64-gnu": "workspace:*",
    "@nifrajs/node-engine-linux-x64-musl": "workspace:*",
    "@nifrajs/node-engine-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@nifrajs/core": "workspace:*",
    "@nifrajs/node": "workspace:*",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nifrajs/nifra.git",
    "directory": "packages/node-engine"
  },
  "bugs": {
    "url": "https://github.com/nifrajs/nifra/issues"
  },
  "homepage": "https://github.com/nifrajs/nifra#readme"
}
