{
  "name": "@nifrajs/otel",
  "version": "4.0.1",
  "description": "Distributed tracing for nifra - W3C traceparent/tracestate propagation + OpenTelemetry-semantic-convention spans via a pluggable exporter. Bridge to the OpenTelemetry SDK or log spans directly; no SDK bundled. Edge-safe.",
  "keywords": [
    "bun",
    "typescript",
    "nifra",
    "web-framework",
    "full-stack",
    "edge",
    "ssr",
    "opentelemetry",
    "tracing",
    "observability",
    "w3c-traceparent"
  ],
  "type": "module",
  "nifra": {
    "environment": "library"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metrics": {
      "bun": "./src/metrics.ts",
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    },
    "./effects": {
      "bun": "./src/effects.ts",
      "types": "./dist/effects.d.ts",
      "default": "./dist/effects.js"
    },
    "./cache": {
      "bun": "./src/cache.ts",
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./jobs": {
      "bun": "./src/jobs.ts",
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    },
    "./events": {
      "bun": "./src/events.ts",
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./sdk-bridge": {
      "bun": "./src/sdk-bridge.ts",
      "types": "./dist/sdk-bridge.d.ts",
      "default": "./dist/sdk-bridge.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dts.ts dist"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nifrajs/core": "workspace:^"
  },
  "devDependencies": {
    "@nifrajs/cache": "workspace:*",
    "@nifrajs/core": "workspace:*",
    "@nifrajs/events": "workspace:*",
    "@nifrajs/jobs": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nifrajs/nifra.git",
    "directory": "packages/otel"
  },
  "bugs": {
    "url": "https://github.com/nifrajs/nifra/issues"
  },
  "homepage": "https://github.com/nifrajs/nifra#readme"
}
