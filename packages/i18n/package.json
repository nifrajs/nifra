{
  "name": "@nifrajs/i18n",
  "version": "5.8.0",
  "description": "Framework-agnostic i18n for nifra - locale negotiation + a tiny ICU message formatter on the platform Intl. Dependency-free.",
  "keywords": [
    "bun",
    "typescript",
    "nifra",
    "i18n",
    "internationalization",
    "localization",
    "icu",
    "intl",
    "translations"
  ],
  "type": "module",
  "nifra": {
    "environment": "library"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./detector": {
      "bun": "./src/detector.ts",
      "types": "./dist/detector.d.ts",
      "default": "./dist/detector.js"
    },
    "./routing": {
      "bun": "./src/routing.ts",
      "types": "./dist/routing.d.ts",
      "default": "./dist/routing.js"
    },
    "./rich": {
      "bun": "./src/rich.ts",
      "types": "./dist/rich.d.ts",
      "default": "./dist/rich.js"
    },
    "./check": {
      "bun": "./src/check.ts",
      "types": "./dist/check.d.ts",
      "default": "./dist/check.js"
    },
    "./copy": {
      "bun": "./src/copy.ts",
      "types": "./dist/copy.d.ts",
      "default": "./dist/copy.js"
    },
    "./extract": {
      "bun": "./src/extract.ts",
      "types": "./dist/extract.d.ts",
      "default": "./dist/extract.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dts.ts dist"
  },
  "peerDependencies": {
    "@nifrajs/core": "workspace:^",
    "typescript": "^5.9.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@nifrajs/core": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nifrajs/core": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nifrajs/nifra.git",
    "directory": "packages/i18n"
  },
  "bugs": {
    "url": "https://github.com/nifrajs/nifra/issues"
  },
  "homepage": "https://github.com/nifrajs/nifra#readme",
  "dependencies": {
    "@nifrajs/utils": "workspace:*"
  }
}
