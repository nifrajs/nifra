{
  "name": "@nifrajs/i18n",
  "version": "2.11.0",
  "description": "Framework-agnostic i18n for nifra - locale negotiation + a tiny ICU message formatter on the platform Intl. Dependency-free.",
  "keywords": [
    "bun",
    "typescript",
    "nifra",
    "i18n",
    "internationalization",
    "localization",
    "icu",
    "intl",
    "translations"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./detector": {
      "bun": "./src/detector.ts",
      "types": "./dist/detector.d.ts",
      "default": "./dist/detector.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dts.ts dist"
  },
  "peerDependencies": {
    "@nifrajs/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@nifrajs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nifrajs/core": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nifrajs/nifra.git",
    "directory": "packages/i18n"
  },
  "bugs": {
    "url": "https://github.com/nifrajs/nifra/issues"
  },
  "homepage": "https://github.com/nifrajs/nifra#readme"
}
