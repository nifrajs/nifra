{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "allowImportingTsExtensions": true,
    "types": ["bun", "react", "vite/client", "@vitejs/plugin-rsc/types"],
    "jsx": "react-jsx",
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // It imports the route table the browser check writes before it builds.
  "exclude": ["entry.client.ts"]
}
