{
  "name": "@nifrajs/web-react",
  "version": "5.7.0",
  "description": "React render adapter for @nifrajs/web - SSR + hydration (Bun-native JSX, no Babel).",
  "keywords": [
    "bun",
    "typescript",
    "nifra",
    "react",
    "ssr",
    "hydration",
    "streaming-ssr",
    "render-adapter",
    "full-stack"
  ],
  "type": "module",
  "nifra": {
    "environment": "library"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ppr": {
      "bun": "./src/ppr.ts",
      "types": "./dist/ppr.d.ts",
      "default": "./dist/ppr.js"
    },
    "./client": {
      "bun": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./keep-alive": {
      "bun": "./src/keep-alive.ts",
      "types": "./dist/keep-alive.d.ts",
      "default": "./dist/keep-alive.js"
    },
    "./await": {
      "bun": "./src/await.ts",
      "types": "./dist/await.d.ts",
      "default": "./dist/await.js"
    },
    "./island": {
      "bun": "./src/island.ts",
      "types": "./dist/island.d.ts",
      "default": "./dist/island.js"
    },
    "./fetcher": {
      "bun": "./src/fetcher.ts",
      "types": "./dist/fetcher.d.ts",
      "default": "./dist/fetcher.js"
    },
    "./router": {
      "bun": "./src/router.ts",
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./query": {
      "bun": "./src/query.ts",
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./i18n": {
      "bun": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    },
    "./image": {
      "bun": "./src/image.ts",
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./content": {
      "bun": "./src/content.ts",
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./fn": {
      "bun": "./src/fn.ts",
      "types": "./dist/fn.d.ts",
      "default": "./dist/fn.js"
    },
    "./server-components/guard": {
      "bun": "./src/server-components/guard.ts",
      "types": "./dist/server-components/guard.d.ts",
      "default": "./dist/server-components/guard.js"
    },
    "./server-components/jsx-runtime": {
      "bun": "./src/server-components/jsx-runtime.ts",
      "types": "./dist/server-components/jsx-runtime.d.ts",
      "default": "./dist/server-components/jsx-runtime.js"
    },
    "./server-components/jsx-dev-runtime": {
      "bun": "./src/server-components/jsx-dev-runtime.ts",
      "types": "./dist/server-components/jsx-dev-runtime.d.ts",
      "default": "./dist/server-components/jsx-dev-runtime.js"
    },
    "./server-components": {
      "bun": "./src/server-components/server.ts",
      "types": "./dist/server-components/server.d.ts",
      "default": "./dist/server-components/server.js"
    },
    "./server-components/rsc": {
      "bun": "./src/server-components/rsc.ts",
      "types": "./dist/server-components/rsc.d.ts",
      "default": "./dist/server-components/rsc.js"
    },
    "./server-components/client": {
      "bun": "./src/server-components/client.ts",
      "types": "./dist/server-components/client.d.ts",
      "default": "./dist/server-components/client.js"
    },
    "./server-components/outlet": {
      "bun": "./src/server-components/outlet.ts",
      "types": "./dist/server-components/outlet.d.ts",
      "default": "./dist/server-components/outlet.js"
    },
    "./server-components/nested": {
      "bun": "./src/server-components/nested.ts",
      "types": "./dist/server-components/nested.d.ts",
      "default": "./dist/server-components/nested.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dts.ts dist"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nifrajs/core": "workspace:*",
    "@nifrajs/web": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@vitejs/plugin-rsc": "0.5.35",
    "react-server-dom-webpack": "19.3.1",
    "@nifrajs/i18n": "workspace:^",
    "@nifrajs/image": "workspace:^"
  },
  "devDependencies": {
    "@nifrajs/i18n": "workspace:*",
    "@nifrajs/image": "workspace:*",
    "@nifrajs/schema": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-rsc": "0.5.35",
    "happy-dom": "21.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "19.3.1",
    "vite": "8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nifrajs/nifra.git",
    "directory": "packages/web-react"
  },
  "bugs": {
    "url": "https://github.com/nifrajs/nifra/issues"
  },
  "homepage": "https://github.com/nifrajs/nifra#readme",
  "peerDependenciesMeta": {
    "@nifrajs/i18n": {
      "optional": true
    },
    "@nifrajs/image": {
      "optional": true
    },
    "@vitejs/plugin-rsc": {
      "optional": true
    },
    "react-server-dom-webpack": {
      "optional": true
    }
  }
}
