{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["bun", "react", "react-dom"],
    "rootDirs": [".", "./.nifra/types"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "public",
    "dist-server",
    ".build",
    ".nifra",
    ".wrangler",
    "backend/server-manifest.ts",
    "backend/dev-server.ts",
    "backend/worker.ts",
    "build.ts"
  ]
}
