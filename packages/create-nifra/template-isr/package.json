{
  "name": "nifra-isr",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bunx wrangler dev --var NIFRA_ALLOW_MEMORY_RATE_LIMIT:true --var REVALIDATE_SECRET:dev-secret",
    "dev:bun": "bun run backend/dev-server.ts",
    "check": "nifra check && nifra assure"
  },
  "dependencies": {
    "@nifrajs/client": "^5.2.1",
    "@nifrajs/core": "^5.2.1",
    "@nifrajs/middleware": "^5.2.1",
    "@nifrajs/schema": "^5.2.1",
    "@nifrajs/web": "^5.2.1",
    "@nifrajs/web-react": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nifrajs/cli": "^5.2.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.3"
  }
}
