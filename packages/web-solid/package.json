{
  "name": "@nifrajs/web-solid",
  "version": "5.8.0",
  "description": "Solid render adapter for @nifrajs/web - SSR + hydration, with the Solid Babel build plugin (@nifrajs/web-solid/plugin).",
  "keywords": [
    "bun",
    "typescript",
    "nifra",
    "solid",
    "solidjs",
    "ssr",
    "hydration",
    "render-adapter",
    "full-stack"
  ],
  "type": "module",
  "nifra": {
    "environment": "library"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "bun": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./keep-alive": {
      "bun": "./src/keep-alive.ts",
      "types": "./dist/keep-alive.d.ts",
      "default": "./dist/keep-alive.js"
    },
    "./plugin": {
      "bun": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./await": {
      "bun": "./src/await.ts",
      "types": "./dist/await.d.ts",
      "default": "./dist/await.js"
    },
    "./ppr": {
      "bun": "./src/ppr.ts",
      "types": "./dist/ppr.d.ts",
      "default": "./dist/ppr.js"
    },
    "./fetcher": {
      "bun": "./src/fetcher.ts",
      "types": "./dist/fetcher.d.ts",
      "default": "./dist/fetcher.js"
    },
    "./router": {
      "bun": "./src/router.ts",
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./query": {
      "bun": "./src/query.ts",
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./i18n": {
      "bun": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    },
    "./image": {
      "bun": "./src/image.ts",
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./content": {
      "bun": "./src/content.ts",
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./mdx": {
      "bun": "./src/mdx.ts",
      "types": "./dist/mdx.d.ts",
      "default": "./dist/mdx.js"
    },
    "./svg": {
      "bun": "./src/svg.ts",
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg.js"
    },
    "./mdx-runtime": {
      "bun": "./src/mdx-runtime.ts",
      "types": "./dist/mdx-runtime.d.ts",
      "default": "./dist/mdx-runtime.js"
    },
    "./fn": {
      "bun": "./src/fn.ts",
      "types": "./dist/fn.d.ts",
      "default": "./dist/fn.js"
    },
    "./server-components": {
      "bun": "./src/server-components/server.ts",
      "types": "./dist/server-components/server.d.ts",
      "default": "./dist/server-components/server.js"
    },
    "./server-components/client": {
      "bun": "./src/server-components/client.ts",
      "types": "./dist/server-components/client.d.ts",
      "default": "./dist/server-components/client.js"
    },
    "./server-components/outlet": {
      "types": "./dist/server-components/Outlet.d.ts",
      "default": "./src/server-components/Outlet.tsx"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dts.ts dist"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@nifrajs/core": "workspace:*",
    "@nifrajs/web": "workspace:*",
    "babel-preset-solid": "^1.9.3",
    "solid-refresh": "^0.7.8"
  },
  "peerDependencies": {
    "@mdx-js/mdx": "^3",
    "solid-js": "^1.9.0",
    "@nifrajs/i18n": "workspace:^",
    "@nifrajs/image": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@mdx-js/mdx": {
      "optional": true
    },
    "@nifrajs/i18n": {
      "optional": true
    },
    "@nifrajs/image": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nifrajs/i18n": "workspace:*",
    "@nifrajs/image": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "happy-dom": "21.0.4",
    "solid-js": "^1.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nifrajs/nifra.git",
    "directory": "packages/web-solid"
  },
  "bugs": {
    "url": "https://github.com/nifrajs/nifra/issues"
  },
  "homepage": "https://github.com/nifrajs/nifra#readme"
}
