{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The browser navigation layer (src/client.ts) needs DOM types. The rest of @nifrajs/web is
    // DOM-free and typechecked by the root config; this config covers only the client layer.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@nifrajs/core": ["../core/src/index.ts"],
      "@nifrajs/core/server": ["../core/src/server.ts"],
      "@nifrajs/core/pattern": ["../core/src/router/pattern.ts"],
      "@nifrajs/core/mount": ["../core/src/mount.ts"],
      "@nifrajs/core/range": ["../core/src/range.ts"],
      "@nifrajs/core/static-file": ["../core/src/static-file.ts"],
      "@nifrajs/core/reflection": ["../core/src/reflection.ts"],
      "@nifrajs/core/evidence": ["../core/src/evidence.ts"],
      "@nifrajs/core/transport-codec": ["../core/src/transport-codec.ts"]
    }
  },
  "include": [
    "src/client.ts",
    "src/live-client.ts",
    "src/islands.ts",
    "src/islands-swap.ts",
    "test/islands.test.ts",
    "test/apply-head.test.ts",
    "test/client-browser.test.ts",
    "test/css-loading.test.ts",
    "test/live-client.test.ts"
  ]
}
