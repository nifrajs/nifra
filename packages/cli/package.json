{
  "name": "@nifrajs/cli",
  "version": "3.1.0",
  "description": "The nifra CLI - zero-config dev/build/start for a nifra app (`nifra dev`, `nifra build`, `nifra start`).",
  "keywords": [
    "bun",
    "typescript",
    "nifra",
    "web-framework",
    "full-stack",
    "edge",
    "ssr",
    "cli",
    "mcp",
    "ai-agent",
    "codegen",
    "dev-server"
  ],
  "type": "module",
  "bin": {
    "nifra": "./dist/cli.js"
  },
  "exports": {
    "./mcp": {
      "bun": "./src/mcp-http.ts",
      "types": "./dist/mcp-http.d.ts",
      "default": "./dist/mcp-http.js"
    },
    "./diagnostics": {
      "bun": "./src/diagnostics.ts",
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./rules": {
      "bun": "./src/rules/index.ts",
      "types": "./dist/rules/index.d.ts",
      "default": "./dist/rules/index.js"
    },
    "./fix-recipes": {
      "bun": "./src/fix-recipes.ts",
      "types": "./dist/fix-recipes.d.ts",
      "default": "./dist/fix-recipes.js"
    },
    "./assure": {
      "bun": "./src/assure.ts",
      "types": "./dist/assure.d.ts",
      "default": "./dist/assure.js"
    },
    "./work-graph": {
      "bun": "./src/work-graph.ts",
      "types": "./dist/work-graph.d.ts",
      "default": "./dist/work-graph.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dts.ts dist"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nifrajs/client": "workspace:*",
    "@nifrajs/core": "workspace:*",
    "@nifrajs/mcp": "workspace:*",
    "@nifrajs/runner": "workspace:*",
    "@nifrajs/schema": "workspace:*",
    "@nifrajs/testing": "workspace:*",
    "@nifrajs/web": "workspace:*",
    "create-nifra": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nifrajs/nifra.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/nifrajs/nifra/issues"
  },
  "homepage": "https://github.com/nifrajs/nifra#readme",
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
