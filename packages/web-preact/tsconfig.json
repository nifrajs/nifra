{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Frontend adapter: needs DOM types (client hydrate casts the container to `Element`).
    // Excluded from the root typecheck; checked via the `typecheck` script.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // The keep-alive and partial prerendering fixtures' routes are Preact JSX, in .tsx files as route
    // discovery requires.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@nifrajs/web": ["../web/src/index.ts"],
      "@nifrajs/web-preact/ppr": ["./src/ppr.ts"],
      "@nifrajs/core": ["../core/src/index.ts"],
      "@nifrajs/core/mount": ["../core/src/mount.ts"],
      "@nifrajs/core/transport-codec": ["../core/src/transport-codec.ts"],
      "@nifrajs/core/server": ["../core/src/server.ts"],
      "@nifrajs/core/pattern": ["../core/src/router/pattern.ts"],
      "@nifrajs/core/range": ["../core/src/range.ts"],
      "@nifrajs/core/serve-static": ["../core/src/serve-static.ts"],
      "@nifrajs/core/static-file": ["../core/src/static-file.ts"],
      "@nifrajs/core/reflection": ["../core/src/reflection.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
