{
  "name": "@nifrajs/web-preact",
  "version": "5.9.0",
  "description": "Preact render adapter for @nifrajs/web - streaming SSR + hydration (no build plugin).",
  "keywords": [
    "bun",
    "typescript",
    "nifra",
    "preact",
    "ssr",
    "hydration",
    "streaming-ssr",
    "render-adapter",
    "full-stack"
  ],
  "type": "module",
  "nifra": {
    "environment": "library"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "bun": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./keep-alive": {
      "bun": "./src/keep-alive.ts",
      "types": "./dist/keep-alive.d.ts",
      "default": "./dist/keep-alive.js"
    },
    "./await": {
      "bun": "./src/await.ts",
      "types": "./dist/await.d.ts",
      "default": "./dist/await.js"
    },
    "./ppr": {
      "bun": "./src/ppr.ts",
      "types": "./dist/ppr.d.ts",
      "default": "./dist/ppr.js"
    },
    "./fetcher": {
      "bun": "./src/fetcher.ts",
      "types": "./dist/fetcher.d.ts",
      "default": "./dist/fetcher.js"
    },
    "./router": {
      "bun": "./src/router.ts",
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./query": {
      "bun": "./src/query.ts",
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./i18n": {
      "bun": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    },
    "./image": {
      "bun": "./src/image.ts",
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./content": {
      "bun": "./src/content.ts",
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./fn": {
      "bun": "./src/fn.ts",
      "types": "./dist/fn.d.ts",
      "default": "./dist/fn.js"
    },
    "./server-components": {
      "bun": "./src/server-components/server.ts",
      "types": "./dist/server-components/server.d.ts",
      "default": "./dist/server-components/server.js"
    },
    "./server-components/client": {
      "bun": "./src/server-components/client.ts",
      "types": "./dist/server-components/client.d.ts",
      "default": "./dist/server-components/client.js"
    },
    "./server-components/outlet": {
      "bun": "./src/server-components/outlet.ts",
      "types": "./dist/server-components/outlet.d.ts",
      "default": "./dist/server-components/outlet.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dts.ts dist"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nifrajs/core": "workspace:*",
    "@nifrajs/web": "workspace:*",
    "preact-render-to-string": "^6.8.1"
  },
  "peerDependencies": {
    "preact": "^10.19.0 || ^11.0.0",
    "@nifrajs/i18n": "workspace:^",
    "@nifrajs/image": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@nifrajs/i18n": {
      "optional": true
    },
    "@nifrajs/image": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nifrajs/i18n": "workspace:*",
    "@nifrajs/image": "workspace:*",
    "happy-dom": "21.0.4",
    "preact": "^11.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nifrajs/nifra.git",
    "directory": "packages/web-preact"
  },
  "bugs": {
    "url": "https://github.com/nifrajs/nifra/issues"
  },
  "homepage": "https://github.com/nifrajs/nifra#readme"
}
