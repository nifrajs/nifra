{
  "name": "@nifrajs/workbench",
  "version": "3.1.0",
  "private": true,
  "description": "Lightweight local Workbench client for nifra-agent.",
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --target bun --outfile dist/server.js",
    "desktop:dev": "cargo tauri dev --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "cargo tauri build --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@nifrajs/coding-agent": "workspace:*"
  }
}
