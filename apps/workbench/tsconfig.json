{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // src/server.ts is a Bun process; src/browser.ts is a browser bundle that needs DOM types.
    // Both are checked in one pass; the DOM lib is harmless for the server module.
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*", "scripts/**/*", "test/**/*"]
}
